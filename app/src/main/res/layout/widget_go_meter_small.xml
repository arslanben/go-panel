<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/smallWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp"
    tools:ignore="SmallSp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/smallWidgetTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:text="@string/widget_title"
            android:textAllCaps="true"
            android:textColor="#B3FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/smallWidgetEnds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:textColor="@color/widget_text_secondary"
            android:textSize="8sp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/smallWidgetSettings"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/settings"
            android:padding="2dp"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/smallWidgetBigPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/reset_unknown"
            android:textColor="@color/accent"
            android:textSize="28sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/smallRowFiveLabel"
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/meter_five_hour_tiny"
                    android:textColor="#F9FAFB"
                    android:textSize="9sp" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_weight="1">

                    <ProgressBar
                        android:id="@+id/smallRowFiveBarGreen"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:max="100"
                        android:maxHeight="3dp"
                        android:minHeight="3dp"
                        android:progress="0"
                        android:progressDrawable="@drawable/widget_progress" />

                    <ProgressBar
                        android:id="@+id/smallRowFiveBarYellow"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:max="100"
                        android:maxHeight="3dp"
                        android:minHeight="3dp"
                        android:progress="0"
                        android:progressDrawable="@drawable/widget_progress_yellow"
                        android:visibility="gone" />

                    <ProgressBar
                        android:id="@+id/smallRowFiveBarRed"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:max="100"
                        android:maxHeight="3dp"
                        android:minHeight="3dp"
                        android:progress="0"
                        android:progressDrawable="@drawable/widget_progress_red"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/smallRowFivePercent"
                    android:layout_width="34dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:maxLines="1"
                    android:text="@string/reset_unknown"
                    android:textColor="@color/accent"
                    android:textSize="9sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/smallRowWeekLabel"
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/meter_week_tiny"
                    android:textColor="#F9FAFB"
                    android:textSize="9sp" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_weight="1">

                    <ProgressBar
                        android:id="@+id/smallRowWeekBarGreen"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:max="100"
                        android:maxHeight="3dp"
                        android:minHeight="3dp"
                        android:progress="0"
                        android:progressDrawable="@drawable/widget_progress" />

                    <ProgressBar
                        android:id="@+id/smallRowWeekBarYellow"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:max="100"
                        android:maxHeight="3dp"
                        android:minHeight="3dp"
                        android:progress="0"
                        android:progressDrawable="@drawable/widget_progress_yellow"
                        android:visibility="gone" />

                    <ProgressBar
                        android:id="@+id/smallRowWeekBarRed"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:max="100"
                        android:maxHeight="3dp"
                        android:minHeight="3dp"
                        android:progress="0"
                        android:progressDrawable="@drawable/widget_progress_red"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/smallRowWeekPercent"
                    android:layout_width="34dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:maxLines="1"
                    android:text="@string/reset_unknown"
                    android:textColor="@color/accent"
                    android:textSize="9sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/smallRowMonthLabel"
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="@string/meter_month_tiny"
                    android:textColor="#F9FAFB"
                    android:textSize="9sp" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_weight="1">

                    <ProgressBar
                        android:id="@+id/smallRowMonthBarGreen"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:max="100"
                        android:maxHeight="3dp"
                        android:minHeight="3dp"
                        android:progress="0"
                        android:progressDrawable="@drawable/widget_progress" />

                    <ProgressBar
                        android:id="@+id/smallRowMonthBarYellow"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:max="100"
                        android:maxHeight="3dp"
                        android:minHeight="3dp"
                        android:progress="0"
                        android:progressDrawable="@drawable/widget_progress_yellow"
                        android:visibility="gone" />

                    <ProgressBar
                        android:id="@+id/smallRowMonthBarRed"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:max="100"
                        android:maxHeight="3dp"
                        android:minHeight="3dp"
                        android:progress="0"
                        android:progressDrawable="@drawable/widget_progress_red"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/smallRowMonthPercent"
                    android:layout_width="34dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:maxLines="1"
                    android:text="@string/reset_unknown"
                    android:textColor="@color/accent"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
